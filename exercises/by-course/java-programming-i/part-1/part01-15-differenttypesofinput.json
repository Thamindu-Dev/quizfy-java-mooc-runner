    "sampleOutputs": [
      {
        "caption": "Sample output",
        "lines": [
          "Give a string:",
          {
            "text": "bye-bye",
            "isInput": true
          },
          "Give an integer:",
          {
            "text": "11",
            "isInput": true
          },
          "Give a double:",
          {
            "text": "4.2",
            "isInput": true
          },
          "Give a boolean:",
          {
            "text": "true",
            "isInput": true
          },
          "You gave the string bye-bye",
          "You gave the integer 11",
          "You gave the double 4.2",
          "You gave the boolean true"
        ]
      },
      {
        "caption": "Sample output",
        "lines": [
          "Give a string:",
          {
            "text": "Oops!",
            "isInput": true
          },
          "Give an integer:",
          {
            "text": "-4",
            "isInput": true
          },
          "Give a double:",
          {
            "text": "3200.1",
            "isInput": true
          },
          "Give a boolean:",
          {
            "text": "false",
            "isInput": true
          },
          "You gave the string Oops!",
          "You gave the integer -4",
          "You gave the double 3200.1",
          "You gave the boolean false"
        ]
      }
    ]
  }
