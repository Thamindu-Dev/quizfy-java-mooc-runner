  "title": "Checking the age",
  "prompt": {
    "points": 1,
    "paragraphs": [
      "Write a program that prompts the user to input their age and checks whether or not it is possible (at least 0 and at most 120). Only use a single `if`-command in your program."
    ],
    "sampleOutputs": [
      {
        "caption": "Sample output",
        "lines": [
          "How old are you?",
          {
            "text": "10",
            "isInput": true
          },
          "OK"
        ]
      },
      {
        "caption": "Sample output",
        "lines": [
          "How old are you?",
          {
            "text": "55",
            "isInput": true
          },
          "OK"
        ]
      },
      {
        "caption": "Sample output",
        "lines": [
          "How old are you?",
          {
            "text": "-3",
            "isInput": true
          },
          "Impossible!"
        ]
      },
      {
        "caption": "Sample output",
        "lines": [
          "How old are you?",
          {
            "text": "150",
            "isInput": true
          },
          "Impossible!"
        ]
      }
    ]
  }
