      ],
      "codeSnippet": "String text = \"volcanologist\";\n\nif (text.contains(\"can\")) {\n    System.out.println(\"can was found\");\n}\n\nif (!text.contains(\"tin\")) {\n    System.out.println(\"tin wasn't found\");\n}",
